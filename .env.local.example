# EmailJS credentials for the Collab form (src/components/portfolio/collab-form.tsx).
# Create a free account at https://emailjs.com, connect an Email Service to
# watson.cu.28@gmail.com, and create a template with variables: from_name,
# reply_to, subject, message. Copy this file to .env.local and fill in the
# three IDs from the EmailJS dashboard.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# URL of the chat backend (see worker/README.md). This is a public endpoint
# URL, not a secret — the Anthropic API key itself lives only as a Cloudflare
# Worker secret and never appears in this app. Point this at the local
# `wrangler dev` URL while developing, e.g. http://127.0.0.1:8787/chat.
NEXT_PUBLIC_CHAT_WORKER_URL=
