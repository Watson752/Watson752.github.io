# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local.example
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# obsidian vault (source of truth for portfolio content — never committed;
# only src/data/generated/*.json, produced by `npm run export:vault`, ships)
/vault/

# cloudflare worker (chat backend) — local secrets and build output only;
# ANTHROPIC_API_KEY is a wrangler secret and must never appear here
/worker/.dev.vars
/worker/node_modules
/worker/.wrangler
